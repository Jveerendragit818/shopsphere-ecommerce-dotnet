<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ShopSphere</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="ss-auth-body">

    <header class="ss-auth-navbar">
        <a asp-controller="Home" asp-action="Index" class="ss-auth-brand">
            <span class="ss-brand-mark">S</span>
            <span>ShopSphere</span>
        </a>

        <a asp-controller="Home" asp-action="Index" class="ss-auth-home">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 11.5 12 4l9 7.5"></path>
                <path d="M5.5 10.5V20h13v-9.5"></path>
                <path d="M9.5 20v-5h5v5"></path>
            </svg>
            <span>Back to Store</span>
        </a>
    </header>

    <main class="ss-auth-content">
        @RenderBody()
    </main>

    <footer class="ss-auth-footer">
        <span>© @DateTime.Now.Year ShopSphere. All rights reserved.</span>
        <span>Smart E-Commerce &amp; Order Management Platform</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>