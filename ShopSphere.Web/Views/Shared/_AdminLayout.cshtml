<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopSphere Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="ss-admin-body">
    <partial name="_AdminNavbar" />

    <div class="ss-admin-shell">
        <partial name="_AdminSidebar" />

        <div class="ss-admin-page-area">
            <main class="ss-admin-page-content">
                @RenderBody()
            </main>

            <footer class="ss-admin-footer">
                <span>ShopSphere Admin</span>
                <span>Smart E-Commerce &amp; Order Management Platform</span>
            </footer>
        </div>
    </div>

    <div class="ss-admin-sidebar-overlay" id="adminSidebarOverlay"></div>

    <div class="ss-toast" id="ssToast">
        <strong id="ssToastTitle">ShopSphere</strong>
        <span id="ssToastMessage">Action completed.</span>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>