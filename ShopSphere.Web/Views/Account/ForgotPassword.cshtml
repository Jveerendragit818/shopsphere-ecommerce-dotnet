@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<section class="ss-auth-page">
    <div class="ss-auth-card ss-forgot-card">
        <div class="ss-auth-header">
            <span class="ss-auth-eyebrow">Account Recovery</span>
            <h1>Forgot your password?</h1>
            <p>Enter the email address associated with your ShopSphere account and we’ll help you recover access.</p>
        </div>

        @if (ViewBag.ForgotError != null)
        {
            <div class="ss-auth-error">
                @ViewBag.ForgotError
            </div>
        }

        @if (ViewBag.ForgotSuccess != null)
        {
            <div class="ss-auth-success">
                <div class="ss-auth-success-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m5 12 4 4L19 6"></path>
                    </svg>
                </div>
                <div>
                    <strong>Check your inbox</strong>
                    <span>@ViewBag.ForgotSuccess</span>
                </div>
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="ss-auth-form">
            <div class="ss-form-group">
                <label for="email">Email Address</label>

                <div class="ss-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 6h16v12H4z"></path>
                        <path d="m4 7 8 6 8-6"></path>
                    </svg>

                    <input type="email"
                           id="email"
                           name="email"
                           value="@ViewBag.Email"
                           placeholder="Enter your email address"
                           required />
                </div>
            </div>

            <button type="submit" class="ss-auth-submit">
                Send Reset Link
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="m13 6 6 6-6 6"></path>
                </svg>
            </button>
        </form>

        <div class="ss-auth-divider">
            <span>Remember your password?</span>
        </div>

        <a asp-controller="Account" asp-action="Login" class="ss-auth-register">
            Back to Login
        </a>
    </div>
</section>