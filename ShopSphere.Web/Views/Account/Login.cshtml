@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Login";
}

<section class="ss-auth-page">
    <div class="ss-auth-card">
        <div class="ss-auth-header">
            <span class="ss-auth-eyebrow">Welcome back</span>
            <h1>Sign in to ShopSphere</h1>
            <p>Access your orders, wishlist, profile and shopping preferences.</p>
        </div>

        @if (ViewBag.LoginError != null)
        {
            <div class="ss-auth-error">
                @ViewBag.LoginError
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" class="ss-auth-form">
            <div class="ss-form-group">
                <label for="email">Email Address</label>
                <div class="ss-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 6h16v12H4z"></path>
                        <path d="m4 7 8 6 8-6"></path>
                    </svg>
                    <input type="email" id="email" name="email" value="@ViewBag.Email" placeholder="Enter your email address" required />
                </div>
            </div>

            <div class="ss-form-group">
                <div class="ss-form-label-row">
                    <label for="password">Password</label>
                    <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                </div>

                <div class="ss-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                        <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                    </svg>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required />
                    <button type="button" class="ss-password-toggle" id="passwordToggle" aria-label="Show password">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                            <circle cx="12" cy="12" r="2.5"></circle>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="ss-auth-options">
                <label class="ss-check">
                    <input type="checkbox" name="rememberMe" value="true" />
                    <span>Remember me</span>
                </label>
            </div>

            <button type="submit" class="ss-auth-submit">
                Sign In
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="m13 6 6 6-6 6"></path>
                </svg>
            </button>
        </form>

        <div class="ss-auth-divider">
            <span>New to ShopSphere?</span>
        </div>

        <a asp-controller="Account" asp-action="Register" class="ss-auth-register">
            Create an account
        </a>

        <div class="ss-auth-demo">
            <strong>Demo Login</strong>
            <span>demo@shopsphere.com</span>
            <span>Password: 1234</span>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const password = document.getElementById("password");
            const toggle = document.getElementById("passwordToggle");

            if (!password || !toggle) return;

            toggle.addEventListener("click", function () {
                password.type = password.type === "password" ? "text" : "password";
            });
        });
    </script>
}