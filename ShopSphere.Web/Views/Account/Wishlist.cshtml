<section class="ss-wishlist-page">

    <div class="ss-wishlist-heading">
        <div>
            <span class="ss-section-eyebrow">MY ACCOUNT</span>
            <h1>My Wishlist</h1>
            <p>Save products you love and come back to them whenever you’re ready.</p>
        </div>

        <a asp-controller="Product" asp-action="Index" class="ss-wishlist-shop-button">
            Continue Shopping
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
            </svg>
        </a>
    </div>

    <div class="ss-wishlist-summary">
        <div class="ss-wishlist-summary-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m12 19-1.4-1.2C6 13.8 4 11.9 4 9.5 4 7.3 5.8 5.5 8 5.5c1.3 0 2.6.6 3.4 1.7C12.2 6.1 13.5 5.5 15 5.5c2.2 0 4 1.8 4 4 0 2.4-2 4.3-6.6 8.3z"></path>
            </svg>
        </div>

        <div>
            <strong id="wishlistCount">@wishlistProducts.Length items saved</strong>
            <span>Your saved products are available here for quick access.</span>
        </div>
    </div>

    <div class="ss-wishlist-grid" id="wishlistGrid"></div>

    <div class="ss-wishlist-empty" id="wishlistEmpty">
        <div class="ss-wishlist-empty-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m12 19-1.4-1.2C6 13.8 4 11.9 4 9.5 4 7.3 5.8 5.5 8 5.5c1.3 0 2.6.6 3.4 1.7C12.2 6.1 13.5 5.5 15 5.5c2.2 0 4 1.8 4 4 0 2.4-2 4.3-6.6 8.3z"></path>
            </svg>
        </div>

        <h2>Your wishlist is empty</h2>
        <p>Save products while browsing and they will appear here.</p>

        <a asp-controller="Product" asp-action="Index" class="ss-wishlist-empty-button">
            Explore Products
        </a>
    </div>

</section>

<script>
    const wishlistProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(wishlistProducts));
</script>