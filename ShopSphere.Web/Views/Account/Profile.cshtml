@{
    ViewData["Title"] = "My Profile";
}

<section class="ss-account-profile-page">
    <div class="ss-profile-page-heading">
        <div>
            <span class="ss-section-eyebrow">MY ACCOUNT</span>
            <h1>My Profile</h1>
            <p>View and manage your ShopSphere personal and account information.</p>
        </div>
        <a asp-controller="Account" asp-action="Index" class="ss-profile-back">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5"></path>
                <path d="m11 6-6 6 6 6"></path>
            </svg>
            Dashboard
        </a>
    </div>

    <div class="ss-profile-layout">
        <section class="ss-profile-main-card">
            <div class="ss-profile-cover">
                <div class="ss-profile-avatar">V</div>
                <div class="ss-profile-heading-info">
                    <h2>Veerendra K.</h2>
                    <span>ShopSphere Customer</span>
                </div>
                <span class="ss-profile-status">Active</span>
            </div>

            <div class="ss-profile-section">
                <div class="ss-profile-section-heading">
                    <div>
                        <span class="ss-section-eyebrow">PERSONAL INFORMATION</span>
                        <h3>Personal Details</h3>
                    </div>
                    <a href="#" class="ss-profile-edit-link">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m4 16 9.5-9.5 4 4L8 20H4v-4Z"></path>
                            <path d="m14 6 2-2a2 2 0 0 1 3 3l-2 2"></path>
                        </svg>
                        Edit Profile
                    </a>
                </div>

                <div class="ss-profile-info-grid">
                    <div class="ss-profile-info-item">
                        <span>Full Name</span>
                        <strong>Veerendra Kadiyala</strong>
                    </div>

                    <div class="ss-profile-info-item">
                        <span>Email Address</span>
                        <strong>demo@shopsphere.com</strong>
                    </div>

                    <div class="ss-profile-info-item">
                        <span>Phone Number</span>
                        <strong>+91 98765 43210</strong>
                    </div>

                    <div class="ss-profile-info-item">
                        <span>Address</span>
                        <strong>Rajkot, Gujarat, India</strong>
                    </div>
                </div>
            </div>

            <div class="ss-profile-section">
                <div class="ss-profile-section-heading">
                    <div>
                        <span class="ss-section-eyebrow">ACCOUNT INFORMATION</span>
                        <h3>Account Details</h3>
                    </div>
                </div>

                <div class="ss-profile-info-grid">
                    <div class="ss-profile-info-item">
                        <span>User ID</span>
                        <strong>SS-CUS-1024</strong>
                    </div>

                    <div class="ss-profile-info-item">
                        <span>Registration Date</span>
                        <strong>15 August 2026</strong>
                    </div>

                    <div class="ss-profile-info-item">
                        <span>Account Status</span>
                        <strong class="ss-profile-active">Active</strong>
                    </div>

                    <div class="ss-profile-info-item">
                        <span>Account Type</span>
                        <strong>Customer</strong>
                    </div>
                </div>
            </div>
        </section>

        <aside class="ss-profile-side">
            <section class="ss-profile-overview-card">
                <div class="ss-profile-section-heading">
                    <div>
                        <span class="ss-section-eyebrow">OVERVIEW</span>
                        <h3>Your Activity</h3>
                    </div>
                </div>

                <div class="ss-profile-overview-list">
                    <div class="ss-profile-overview-item">
                        <span>Total Orders</span>
                        <strong>12</strong>
                    </div>

                    <div class="ss-profile-overview-item">
                        <span>Wishlist Items</span>
                        <strong>5</strong>
                    </div>

                    <div class="ss-profile-overview-item">
                        <span>Reviews</span>
                        <strong>8</strong>
                    </div>

                    <div class="ss-profile-overview-item">
                        <span>Pending Orders</span>
                        <strong>2</strong>
                    </div>
                </div>
            </section>

            <section class="ss-profile-actions-card">
                <span class="ss-section-eyebrow">ACCOUNT ACTIONS</span>
                <h3>Manage Account</h3>

                <div class="ss-profile-actions">
                    <a href="#" class="ss-profile-action">
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m4 16 9.5-9.5 4 4L8 20H4v-4Z"></path>
                                <path d="m14 6 2-2a2 2 0 0 1 3 3l-2 2"></path>
                            </svg>
                        </span>
                        <div>
                            <strong>Edit Profile</strong>
                            <small>Update your personal information</small>
                        </div>
                    </a>

                    <a asp-controller="Account" asp-action="Addresses" class="ss-profile-action">
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 21s7-6.1 7-12A7 7 0 1 0 5 9c0 5.9 7 12 7 12Z"></path>
                                <circle cx="12" cy="9" r="2.5"></circle>
                            </svg>
                        </span>
                        <div>
                            <strong>Manage Addresses</strong>
                            <small>Manage your delivery locations</small>
                        </div>
                    </a>

                    <a asp-controller="Account" asp-action="Security" class="ss-profile-action">
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                            </svg>
                        </span>
                        <div>
                            <strong>Change Password</strong>
                            <small>Update your account password</small>
                        </div>
                    </a>
                </div>
            </section>
        </aside>
    </div>
</section>