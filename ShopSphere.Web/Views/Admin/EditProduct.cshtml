@{
    ViewData["Title"] = "Edit Product";
}

<section class="ss-admin-add-product-page">
    <div class="ss-admin-add-product-header">
        <div>
            <span class="ss-section-eyebrow">Store Management</span>
            <h1>Edit Product</h1>
            <p>Update the details for the selected product.</p>
        </div>

        <a href="/admin/products" class="ss-admin-secondary-btn">Back to Products</a>
    </div>

    <form id="adminEditProductForm" class="ss-admin-add-product-form" novalidate>
        <div class="ss-admin-add-product-grid">
            <div class="ss-admin-add-product-main">

                <div class="ss-admin-form-panel">
                    <div class="ss-admin-form-panel-header">
                        <div>
                            <span class="ss-admin-panel-eyebrow">Basic Information</span>
                            <h2>Product Details</h2>
                        </div>
                    </div>

                    <div class="ss-admin-form-group">
                        <label for="productName">Product Name</label>
                        <input type="hidden" id="productId">
                        <input type="text" id="productName" class="ss-admin-form-control" placeholder="Enter product name">
                        <span class="ss-admin-form-error" id="productNameError"></span>
                    </div>

                    <div class="ss-admin-form-group">
                        <label for="productDescription">Description</label>
                        <textarea id="productDescription" class="ss-admin-form-control ss-admin-textarea" rows="6" placeholder="Write a clear product description"></textarea>
                        <span class="ss-admin-form-error" id="productDescriptionError"></span>
                    </div>

                    <div class="ss-admin-form-row">
                        <div class="ss-admin-form-group">
                            <label for="productCategory">Category</label>
                            <select id="productCategory" class="ss-admin-form-control">
                                <option value="">Select category</option>
                                <option value="Electronics">Electronics</option>
                                <option value="Fashion">Fashion</option>
                                <option value="Jewellery">Jewellery</option>
                                <option value="Shoes">Shoes</option>
                                <option value="Accessories">Accessories</option>
                                <option value="Home Appliances">Home Appliances</option>
                            </select>
                            <span class="ss-admin-form-error" id="productCategoryError"></span>
                        </div>

                        <div class="ss-admin-form-group">
                            <label for="productBrand">Brand</label>
                            <input type="text" id="productBrand" class="ss-admin-form-control" placeholder="Enter brand">
                            <span class="ss-admin-form-error" id="productBrandError"></span>
                        </div>
                    </div>
                </div>

                <div class="ss-admin-form-panel">
                    <div class="ss-admin-form-panel-header">
                        <div>
                            <span class="ss-admin-panel-eyebrow">Pricing & Inventory</span>
                            <h2>Product Information</h2>
                        </div>
                    </div>

                    <div class="ss-admin-form-row">
                        <div class="ss-admin-form-group">
                            <label for="productPrice">Price</label>
                            <div class="ss-admin-input-prefix">
                                <span>₹</span>
                                <input type="number" id="productPrice" class="ss-admin-form-control" min="0" step="0.01" placeholder="0.00">
                            </div>
                            <span class="ss-admin-form-error" id="productPriceError"></span>
                        </div>

                        <div class="ss-admin-form-group">
                            <label for="productStock">Stock</label>
                            <input type="number" id="productStock" class="ss-admin-form-control" min="0" step="1" placeholder="0">
                            <span class="ss-admin-form-error" id="productStockError"></span>
                        </div>
                    </div>

                    <div class="ss-admin-form-row">
                        <div class="ss-admin-form-group">
                            <label for="productRating">Rating</label>
                            <input type="number" id="productRating" class="ss-admin-form-control" min="0" max="5" step="0.1" placeholder="0.0">
                            <span class="ss-admin-form-error" id="productRatingError"></span>
                        </div>

                        <div class="ss-admin-form-group">
                            <label for="productStatus">Status</label>
                            <select id="productStatus" class="ss-admin-form-control">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="ss-admin-form-panel">
                    <div class="ss-admin-form-panel-header">
                        <div>
                            <span class="ss-admin-panel-eyebrow">Catalog Dates</span>
                            <h2>Product Timeline</h2>
                        </div>
                    </div>

                    <div class="ss-admin-form-row">
                        <div class="ss-admin-form-group">
                            <label for="productCreatedDate">Created Date</label>
                            <input type="date" id="productCreatedDate" class="ss-admin-form-control">
                        </div>

                        <div class="ss-admin-form-group">
                            <label for="productUpdatedDate">Updated Date</label>
                            <input type="date" id="productUpdatedDate" class="ss-admin-form-control">
                        </div>
                    </div>
                </div>
            </div>

            <div class="ss-admin-add-product-side">

                <div class="ss-admin-form-panel">
                    <div class="ss-admin-form-panel-header">
                        <div>
                            <span class="ss-admin-panel-eyebrow">Product Image</span>
                            <h2>Image Upload</h2>
                        </div>
                    </div>

                    <div class="ss-admin-image-upload" id="adminImageUpload">
                        <div class="ss-admin-image-preview" id="adminImagePreview">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="4" y="5" width="16" height="14" rx="2"></rect>
                                <circle cx="9" cy="10" r="1.5"></circle>
                                <path d="m5 17 4-4 3 3 2-2 5 5"></path>
                            </svg>
                            <strong>Upload Product Image</strong>
                            <span>PNG, JPG or WEBP</span>
                        </div>

                        <input type="file" id="productImage" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" hidden>

                        <button type="button" class="ss-admin-image-btn" id="chooseProductImage">
                            Choose Image
                        </button>
                    </div>

                    <span class="ss-admin-form-error" id="productImageError"></span>
                </div>

                <div class="ss-admin-form-panel">
                    <div class="ss-admin-form-panel-header">
                        <div>
                            <span class="ss-admin-panel-eyebrow">Preview</span>
                            <h2>Product Summary</h2>
                        </div>
                    </div>

                    <div class="ss-admin-product-live-preview" id="adminProductLivePreview">
                        <div class="ss-admin-live-image" id="adminLiveImage">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="4" y="5" width="16" height="14" rx="2"></rect>
                                <circle cx="9" cy="10" r="1.5"></circle>
                                <path d="m5 17 4-4 3 3 2-2 5 5"></path>
                            </svg>
                        </div>

                        <div class="ss-admin-live-name" id="adminLiveName">Product Name</div>
                        <div class="ss-admin-live-meta" id="adminLiveBrand">Brand</div>
                        <div class="ss-admin-live-price" id="adminLivePrice">₹0</div>
                        <div class="ss-admin-live-stock" id="adminLiveStock">0 in stock</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ss-admin-add-product-actions">
            <a href="/admin/products" class="ss-admin-secondary-btn">Cancel</a>
            <button type="submit" class="ss-btn ss-btn-primary">Save Changes</button>
        </div>
    </form>
</section>