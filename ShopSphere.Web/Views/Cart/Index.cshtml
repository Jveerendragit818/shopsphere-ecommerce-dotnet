@model IEnumerable<ShopSphere.Web.Models.ProductViewModel>

@{
    ViewData["Title"] = "Cart";
}

<section class="ss-cart-page">

    <div class="ss-cart-heading">
        <div>
            <span class="ss-section-eyebrow">SHOPPING CART</span>
            <h1>Your Cart</h1>
            <p>Review your selected products before moving to checkout.</p>
        </div>

        <a asp-controller="Product" asp-action="Index" class="ss-cart-continue">
            Continue Shopping
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
            </svg>
        </a>
    </div>

    <div class="ss-cart-layout">

        <section class="ss-cart-items-card">
            <div class="ss-cart-card-heading">
                <div>
                    <span class="ss-section-eyebrow">YOUR ITEMS</span>
                    <h2>Selected Products</h2>
                </div>

                <span class="ss-cart-count" id="cartItemCount">0 items</span>
            </div>

            <div class="ss-cart-items" id="cartItems"></div>

            <div class="ss-cart-empty" id="cartEmpty">
                <div class="ss-cart-empty-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 5h2l2 11h10l2-8H7"></path>
                        <circle cx="10" cy="20" r="1.5"></circle>
                        <circle cx="17" cy="20" r="1.5"></circle>
                    </svg>
                </div>

                <h2>Your cart is empty</h2>
                <p>Add products from the shop and they will appear here.</p>

                <a asp-controller="Product" asp-action="Index" class="ss-cart-empty-button">
                    Explore Products
                </a>
            </div>
        </section>

        <aside class="ss-cart-summary-card">
            <span class="ss-section-eyebrow">ORDER SUMMARY</span>
            <h2>Summary</h2>

            <div class="ss-cart-summary-row">
                <span>Subtotal</span>
                <strong id="cartSubtotal">₹0</strong>
            </div>

            <div class="ss-cart-summary-row">
                <span>Delivery</span>
                <strong id="cartDelivery">₹0</strong>
            </div>

            <div class="ss-cart-summary-divider"></div>

            <div class="ss-cart-summary-total">
                <span>Total</span>
                <strong id="cartTotal">₹0</strong>
            </div>

            <button type="button" class="ss-cart-checkout" id="cartCheckout">
                Proceed to Checkout
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="m13 6 6 6-6 6"></path>
                </svg>
            </button>

            <div class="ss-cart-trust">
                <div>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                        <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                    </svg>
                    <span>Secure checkout</span>
                </div>

                <div>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 7h12v10H3z"></path>
                        <path d="M15 10h4l2 3v4h-6"></path>
                        <circle cx="7" cy="18" r="1.5"></circle>
                        <circle cx="18" cy="18" r="1.5"></circle>
                    </svg>
                    <span>Reliable delivery</span>
                </div>
            </div>
        </aside>

    </div>

</section>

<script>
    const cartProducts = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model)
    );
</script>